# PostgreSQL connection string (matches docker-compose.yml on port 5440)
DATABASE_URL="postgresql://faststocks:faststocks_dev_password@localhost:5440/fast_stocks?schema=public"

# Backend HTTP port
PORT=3040

# Optional single-user access token.
# Leave empty for local access without authentication.
# Set a secret token to require ?token=<SECRET> URL link or X-Access-Token header.
APP_ACCESS_TOKEN=""
